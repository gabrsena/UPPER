7:["$","div",null,{"className":"bg-zinc-950","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Como transformar o Google Meu Negócio numa máquina de clientes em Salto\",\"author\":{\"@type\":\"Organization\",\"name\":\"Upper Agency\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"Upper Agency\"},\"datePublished\":\"25 Fev, 2026\",\"description\":\"A maioria das empresas tem um perfil no Google Meu Negócio. Poucas sabem usar. Veja como transformar o seu perfil numa máquina de atração de clientes.\"}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.upperagency.com.br\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Salto\",\"item\":\"https://www.upperagency.com.br/cidade/salto\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Blog\",\"item\":\"https://www.upperagency.com.br/cidade/salto#blog\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Como transformar o Google Meu Negócio numa máquina de clientes em Salto\",\"item\":\"https://www.upperagency.com.br/blog/como-transformar-o-google-meu-negocio-numa-maquina-de-clientes-em-salto\"}]}"}}],["$","$L10",null,{}],["$","article",null,{"className":"min-h-screen bg-zinc-950 pt-32 pb-20 px-8","children":["$","div",null,{"className":"max-w-3xl mx-auto space-y-12","children":[["$","$L11",null,{"href":"/blog","className":"flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-emerald-500 hover:text-white transition-colors group","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","classNa
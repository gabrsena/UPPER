1d:["$","p","p-17",{"children":[["$","strong","strong-0",{"children":"O problema:"}]," Um restaurante recebia pedidos pelo WhatsApp das 18h às 23h. Das 20h em diante, a cozinha estava no pico e ninguém conseguia responder as mensagens. Clientes desistiam e pediam pelo iFood — onde o restaurante pagava 30% de comissão."]}]
1e:["$","p","p-18",{"children":["$","strong","strong-0",{"children":"O que foi automatizado:"}]}]
1f:["$","ul","ul-3",{"children":["\n",["$","li","li-0",{"children":"Cardápio interativo no WhatsApp com fotos e preços"}],"\n",["$","li","li-1",{"children":"Pedido feito direto pelo chat, sem precisar de atendente"}],"\n",["$","li","li-2",{"children":"Confirmação automática com tempo estimado de entrega"}],"\n",["$","li","li-3",{"children":"Integração com a impressora da cozinha — pedido chega direto impresso"}],"\n"]}]
20:["$","p","p-19",{"children":[["$","strong","strong-0",{"children":"Resultado:"}]," 40% dos pedidos que antes iam para o iFood passaram a ser feitos pelo WhatsApp direto, sem comissão. Em volume, isso representou R$ 8.000 a mais por mês ficando no caixa do restaurante."]}]
21:["$","p","p-20",{"children":[["$","strong","strong-0",{"children":"Ferramenta usada:"}]," WhatsApp Business API com fluxo de pedidos e integração com impressora térmica."]}]
22:["$","hr","hr-4",{}]

{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[service]/layout,_N_T_/[service]/[city]/layout,_N_T_/[service]/[city]/page,_N_T_/seo-local/porto-feliz"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$service/$d$city/__PAGE__",
    "/$d$service/$d$city",
    "/$d$service",
    "/_index",
    "/_head"
  ]
}
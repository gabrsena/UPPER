6:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Automação com IA\",\"description\":\"Identificamos os processos repetitivos do seu negócio — atendimento, qualificação de leads, envio de propostas, follow-up, relatórios — e construímos automações com IA que executam tudo isso de forma autônoma, permitindo que você e sua equipe foquem no que realmente gera valor.\",\"provider\":{\"@type\":\"Organization\",\"name\":\"Upper Agency\"}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"O que pode ser automatizado com IA?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Atendimento inicial, triagem de leads, envio de propostas, agendamentos, follow-up pós-venda, relatórios e qualquer processo com passos repetitivos e previsíveis.\"}},{\"@type\":\"Question\",\"name\":\"Preciso ter equipe técnica para manter as automações?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Não. A Upper configura, testa e entrega as automações funcionando. Oferecemos suporte contínuo e ajustes conforme o negócio evolui.\"}},{\"@type\":\"Question\",\"name\":\"Funciona integrado com ferramentas que já uso?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sim. Integramos com WhatsApp Business, Google Agenda, planilhas, sistemas de CRM e a maioria das ferramentas usadas por pequenas e médias empresas.\"}}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.upperagency.com.br\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Automação com IA\",\"item\":\"https://www.upperagency.com.br/servicos/automacao-ia\"}]}"}}],["$","$
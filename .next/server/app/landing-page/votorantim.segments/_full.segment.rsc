e:[["$","title","0",{"children":"Landing Page em Votorantim | Upper"}],["$","meta","1",{"name":"description","content":"Uma página que converte visitantes em clientes em Votorantim. Criamos landing pages rápidas, focadas e otimizadas para conversão — com carregamento abaixo de 2 segundos, estrutura de SEO técnico, integração com WhatsApp e design que transmite autoridade imediata. Uma boa landing page converte 3x mais que um site institucional genérico. Estratégias exclusivas para empresas de Votorantim que buscam o topo do Google."}],["$","meta","2",{"name":"author","content":"UPPER."}],["$","meta","3",{"name":"keywords","content":"SEO Local Sorocaba,Google Empresas,Google Maps,Automação WhatsApp,Infraestrutura Digital,Visibilidade Local,GEO"}],["$","meta","4",{"name":"robots","content":"index, follow"}],["$","link","5",{"rel":"canonical","href":"https://www.upperagency.com.br/"}],["$","meta","6",{"property":"og:title","content":"UPPER | SEO Local & Automação WhatsApp em Sorocaba"}],["$","meta","7",{"property":"og:description","content":"Domine o Google Maps em Sorocaba, Votorantim e Itu. Transforme buscas em clientes reais com SEO Local e Automação de WhatsApp."}],["$","meta","8",{"property":"og:locale","content":"pt_BR"}],["$","meta","9",{"property":"og:image","content":"https://upper-agency-sorocaba.vercel.app/og-image.jpg"}],["$","meta","10",{"property":"og:type","content":"website"}],["$","meta","11",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","12",{"name":"twitter:title","content":"UPPER | SEO Local & Automação WhatsApp em Sorocaba"}],["$","meta","13",{"name":"twitter:description","content":"Domine o Google Maps em Sorocaba, Votorantim e Itu. Transforme buscas em clientes reais com SEO Local e Automação de WhatsApp."}],["$","meta","14",{"name":"twitter:image","content":"https://upper-agency-sorocaba.vercel.app/og-image.jpg"}],["$","link","15",{"rel":"icon","href":"/favicon.png"}],["$","link","16",{"rel":"apple-touch-icon","href":"/fav